@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col md:flex-row bg-gray-100">
    <!-- Sidebar -->
    <div class="w-full md:w-64 bg-slate-900 text-white flex flex-col shadow-lg">
        <div class="p-6 border-b border-slate-800">
            <h1 class="text-xl font-bold text-amber-400">🪙 طلایار ابری و جامع</h1>
            <p class="text-xs text-slate-400 mt-1">مدیریت طلا، حسابداری و فروشگاه</p>
        </div>
        <nav class="flex-1 p-4 space-y-1">
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" Match="NavLinkMatch.All" href="">
                <span class="ml-3">📊</span> داشبورد مدیریت
            </NavLink>
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" href="invoices">
                <span class="ml-3">🧾</span> ماژول فروش و فاکتورها
            </NavLink>
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" href="accounting">
                <span class="ml-3">📑</span> اسناد حسابداری اتوماتیک
            </NavLink>
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" href="onlineshop">
                <span class="ml-3">🛒</span> فروشگاه آنلاین مشتریان
            </NavLink>
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" href="customers">
                <span class="ml-3">👥</span> مشتریان و حساب‌ها
            </NavLink>
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" href="inventory">
                <span class="ml-3">📦</span> انبار و موجودی طلا
            </NavLink>
            <NavLink class="flex items-center px-4 py-2.5 rounded-lg hover:bg-slate-800 text-slate-300 hover:text-white transition" href="syncmanager">
                <span class="ml-3">🔄</span> مدیریت همگام‌سازی اندروید
            </NavLink>
        </nav>
        <div class="p-4 border-t border-slate-800 text-xs text-slate-500 text-center">
            نسخه ابری حرفه‌ای v2.2 — پایگاه داده SQL
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white shadow-sm h-16 flex items-center px-6 justify-between border-b">
            <div class="flex items-center space-x-4 space-x-reverse">
                <span class="text-sm font-semibold text-gray-700">پشتیبانی از نرم‌افزار اندروید آفلاین + همگام‌سازی ابری با کد یکتا (Idempotent)</span>
            </div>
            <div class="flex items-center space-x-3 space-x-reverse">
                <span class="bg-amber-100 text-amber-800 text-xs px-3 py-1 rounded-full font-bold">فعال و آنلاین</span>
            </div>
        </header>

        <main class="flex-1 p-6 overflow-y-auto">
            @Body
        </main>
    </div>
</div>
