@page "/shop/requests"
@inject AppDbContext Db
@inject TalayarService Svc

<PageTitle>درخواست‌های خرید — فروشگاه طلایار</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">📩 درخواست‌های خرید</h2>
            <p class="text-sm text-gray-500 mt-1">درخواست‌های ثبت‌شده از فروشگاه آنلاین — پیگیری و تغییر وضعیت.</p>
        </div>
        <a href="/shop" class="bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-xl font-bold shadow transition">🛒 مشاهدهٔ فروشگاه</a>
    </div>

    @if (msg.Length > 0)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 p-3 rounded-xl text-sm font-semibold">@msg</div>
    }

    <!-- آمار -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-2xl shadow-sm border">
            <p class="text-xs text-gray-500">کل درخواست‌ها</p>
            <p class="text-xl font-bold text-gray-800 mt-1">@Talayar.Dig(all.Count)</p>
        </div>
        <div class="bg-white p-4 rounded-2xl shadow-sm border">
            <p class="text-xs text-gray-500">جدید</p>
            <p class="text-xl font-bold text-blue-600 mt-1">@Talayar.Dig(all.Count(r => r.Status == "new"))</p>
        </div>
        <div class="bg-white p-4 rounded-2xl shadow-sm border">
            <p class="text-xs text-gray-500">در حال پیگیری</p>
            <p class="text-xl font-bold text-amber-600 mt-1">@Talayar.Dig(all.Count(r => r.Status == "contacted"))</p>
        </div>
        <div class="bg-white p-4 rounded-2xl shadow-sm border">
            <p class="text-xs text-gray-500">انجام‌شده</p>
            <p class="text-xl font-bold text-green-600 mt-1">@Talayar.Dig(all.Count(r => r.Status == "done"))</p>
        </div>
    </div>

    <!-- فیلتر وضعیت -->
    <div class="flex flex-wrap gap-1 bg-gray-100 rounded-xl p-1 w-fit">
        @for (int i = 0; i < statusFilters.Length; i++)
        {
            var idx = i;
            <button @onclick="() => statusFilter = idx"
                    class="px-4 py-2 rounded-lg text-xs font-bold transition @(statusFilter == idx ? "bg-white shadow text-amber-700" : "text-gray-500")">@statusFilters[idx]</button>
        }
    </div>

    <!-- لیست -->
    <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
        <div class="table-responsive">
            <table class="w-full text-right border-collapse min-w-[760px]">
                <thead>
                    <tr class="bg-gray-50 text-xs text-gray-600 border-b">
                        <th class="p-4">#</th>
                        <th class="p-4">تاریخ</th>
                        <th class="p-4">کالا</th>
                        <th class="p-4">مشتری</th>
                        <th class="p-4">تماس</th>
                        <th class="p-4">تعداد</th>
                        <th class="p-4">توضیحات</th>
                        <th class="p-4">وضعیت</th>
                        <th class="p-4">حذف</th>
                    </tr>
                </thead>
                <tbody class="divide-y text-sm text-gray-700">
                    @foreach (var r in list)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="p-4 font-bold text-amber-600">@Talayar.Dig(r.Id)</td>
                            <td class="p-4 text-xs">@Talayar.Dig(r.DateJ)</td>
                            <td class="p-4 font-semibold">@r.ItemName <span class="text-[10px] text-gray-400 block">کد @Talayar.Dig(r.ItemId)</span></td>
                            <td class="p-4 font-semibold">@r.CustomerName</td>
                            <td class="p-4">
                                <a href="tel:@Talayar.En(r.Phone)" class="text-blue-600 hover:text-blue-800 font-bold text-xs" dir="ltr">@Talayar.Dig(r.Phone)</a>
                            </td>
                            <td class="p-4">@Talayar.Dig(r.Qty)</td>
                            <td class="p-4 text-xs text-gray-500 max-w-[160px] truncate" title="@r.Note">@(r.Note.Length > 0 ? r.Note : "—")</td>
                            <td class="p-4">
                                <select value="@r.Status" @onchange="(e) => OnStatusChange(r.Id, e)"
                                        class="border rounded-lg p-1.5 text-xs font-bold @(r.Status == "new" ? "text-blue-600" : r.Status == "contacted" ? "text-amber-600" : r.Status == "done" ? "text-green-600" : "text-gray-400")">
                                    <option value="new">جدید</option>
                                    <option value="contacted">در حال پیگیری</option>
                                    <option value="done">انجام‌شده</option>
                                    <option value="cancelled">لغو</option>
                                </select>
                            </td>
                            <td class="p-4">
                                <button @onclick="() => Delete(r.Id)" class="text-red-400 hover:text-red-600 text-xs font-bold">🗑</button>
                            </td>
                        </tr>
                    }
                    @if (!list.Any())
                    {
                        <tr><td colspan="9" class="p-10 text-center text-gray-400">درخواستی یافت نشد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly string[] statusFilters = { "همه", "جدید", "در حال پیگیری", "انجام‌شده", "لغو" };

    private List<ShopRequest> all = new();
    private List<ShopRequest> list = new();
    private int statusFilter;
    private string msg = "";

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        all = Db.ShopRequests.OrderByDescending(r => r.Id).Take(300).ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        list = statusFilter switch
        {
            1 => all.Where(r => r.Status == "new").ToList(),
            2 => all.Where(r => r.Status == "contacted").ToList(),
            3 => all.Where(r => r.Status == "done").ToList(),
            4 => all.Where(r => r.Status == "cancelled").ToList(),
            _ => all
        };
    }

    private void OnStatusChange(int id, ChangeEventArgs e)
    {
        ChangeStatus(id, e.Value?.ToString() ?? "new");
    }

    private void ChangeStatus(int id, string status)
    {
        var r = all.FirstOrDefault(x => x.Id == id);
        if (r != null)
        {
            r.Status = status;
            Db.SaveChanges();
            msg = "وضعیت به‌روزرسانی شد ✓";
            Load();
        }
    }

    private void Delete(int id)
    {
        var r = Db.ShopRequests.FirstOrDefault(x => x.Id == id);
        if (r != null)
        {
            Db.ShopRequests.Remove(r);
            Db.SaveChanges();
            msg = "درخواست حذف شد ✓";
            Load();
        }
    }
}
