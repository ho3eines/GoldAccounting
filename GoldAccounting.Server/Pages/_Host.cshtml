@page "/"
@namespace GoldAccounting.Server.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>طلایار — سیستم جامع حسابداری طلا، فروش آنلاین و همگام‌سازی ابری</title>
    <base href="~/" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body class="bg-gray-50 text-gray-800 font-sans">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            خطایی رخ داده است. ممکن است نیاز به بارگذاری مجدد صفحه باشد.
        </environment>
        <environment include="Development">
            یک خطای پردازش رخ داده است. جزئیات بیشتر در کنسول مرورگر.
        </environment>
        <a href="" class="reload">بارگذاری مجدد</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
