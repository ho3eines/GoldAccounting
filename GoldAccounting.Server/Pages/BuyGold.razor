@page "/buy"
@inject AppDbContext Db
@inject TalayarService Svc
@inject NavigationManager Nav

<PageTitle>خرید طلای کارکرده</PageTitle>

<div class="space-y-6 max-w-3xl">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">🛍️ خرید طلای کارکرده</h2>
        <p class="text-sm text-gray-500 mt-1">خرید طلای دست‌دوم / آب‌شده از مشتری یا فروشنده — طلا به موجودی «آب‌شده» اضافه می‌شود.</p>
    </div>

    @if (msg.Length > 0)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 p-3 rounded-xl text-sm font-semibold">@msg</div>
    }
    @if (err.Length > 0)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-xl text-sm font-semibold">@err</div>
    }

    <div class="bg-white rounded-2xl shadow-sm border p-6 space-y-4">
        <div>
            <label class="block text-xs text-gray-500 mb-1">فروشنده</label>
            <select @bind="cid" class="w-full border rounded-xl p-2.5 text-sm">
                <option value="0">بدون مشتری (فروشندهٔ عابر)</option>
                @foreach (var c in Db.Customers.OrderBy(c => c.Code))
                {
                    <option value="@c.Id">@c.Name (@Talayar.Dig(c.Code))</option>
                }
            </select>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs text-gray-500 mb-1">وزن (گرم)</label>
                <input @bind="wInput" class="w-full border rounded-xl p-2.5 text-sm" placeholder="۰" />
            </div>
            <div>
                <label class="block text-xs text-gray-500 mb-1">نرخ خرید هر گرم (تومان)</label>
                <input @bind="rateInput" class="w-full border rounded-xl p-2.5 text-sm" />
            </div>
        </div>
        <div>
            <label class="block text-xs text-gray-500 mb-1">عیار</label>
            <div class="flex gap-1">
                @for (int i = 0; i < Talayar.KARAT_LABELS.Length; i++)
                {
                    var idx = i;
                    <button @onclick="() => { karat = Talayar.KARATS[idx]; FillRateDef(); }" class="flex-1 py-2 rounded-lg text-xs font-bold transition @(karat == Talayar.KARATS[idx] ? "bg-amber-600 text-white" : "bg-gray-100 text-gray-600")">@Talayar.KARAT_LABELS[idx]</button>
                }
            </div>
        </div>
        <div>
            <label class="block text-xs text-gray-500 mb-1">یادداشت</label>
            <input @bind="note" class="w-full border rounded-xl p-2.5 text-sm" placeholder="اختیاری" />
        </div>

        @{
            long w = Talayar.ParseMw(wInput);
            long per = Talayar.ParseMoney(rateInput);
            long total = (long)Math.Round(w * per / 1000.0);
            long eq = Talayar.Equiv750(w, karat);
            long rate = Svc.CurrentRate();
        }
        <div class="bg-slate-900 text-white rounded-xl p-4 space-y-1 text-sm">
            <div class="flex justify-between"><span class="text-slate-300">معادل ۱۸ عیار</span><b>@Talayar.Mw(eq) گرم</b></div>
            @if (rate > 0 && w > 0)
            {
                <div class="flex justify-between"><span class="text-slate-300">ارزش روز (خام)</span><b>@Talayar.Money((long)Math.Round(eq * rate / 1000.0)) تومان</b></div>
            }
            <div class="flex justify-between border-t border-slate-700 pt-2"><span>مبلغ خرید</span><b class="text-amber-400">@Talayar.Money(total) تومان</b></div>
        </div>

        <label class="flex items-center gap-2 text-sm font-bold text-gray-700 bg-gray-50 rounded-xl p-3 cursor-pointer">
            <input type="checkbox" @bind="payNow" class="w-4 h-4 accent-amber-600" />
            پرداخت فوری از صندوق
            @if (cid > 0)
            {
                <span class="text-xs font-normal text-gray-500 mr-2">(در صورت عدم تیک: به حساب مشتری — بستانکاری)</span>
            }
        </label>

        <button @onclick="Save" class="w-full bg-amber-600 hover:bg-amber-700 text-white py-3.5 rounded-2xl font-bold shadow-lg shadow-amber-600/20 transition">⬇ ثبت خرید</button>
    </div>
</div>

@code {
    private int cid;
    private string wInput = "0", rateInput = "", note = "";
    private int karat = 750;
    private bool payNow = true;
    private string msg = "", err = "";

    protected override void OnInitialized()
    {
        FillRateDef();
    }

    private void FillRateDef()
    {
        if (rateInput.Trim().Length == 0)
        {
            long rate = Svc.CurrentRate();
            if (rate > 0)
            {
                long rasub = Svc.GetL("resub", 0);
                long per = (long)Math.Round(rate * karat / 750.0 * (100 - rasub) / 100.0);
                rateInput = per.ToString();
            }
        }
    }

    private void Save()
    {
        err = ""; msg = "";
        long w = Talayar.ParseMw(wInput);
        long per = Talayar.ParseMoney(rateInput);
        if (w <= 0) { err = "وزن معتبر وارد کنید"; return; }
        if (per <= 0) { err = "نرخ خرید را وارد کنید"; return; }
        if (cid == 0) payNow = true;
        string cname = cid > 0 ? (Db.Customers.FirstOrDefault(c => c.Id == cid)?.Name ?? "") : "";
        Svc.SaveBuy(cid, cname, w, karat, per, payNow, note.Trim());
        msg = "خرید ثبت شد ✓";
        Nav.NavigateTo("/gold", forceLoad: true);
    }
}
