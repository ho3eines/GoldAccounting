@page "/accounting"
@inject AppDbContext Db

<PageTitle>اسناد حسابداری اتوماتیک</PageTitle>

<div class="space-y-6">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">📑 اسناد حسابداری دوبل و اتوماتیک</h2>
        <p class="text-sm text-gray-500 mt-1">با ثبت هر فاکتور یا تراکنش، سند حسابداری مربوطه به‌طور خودکار با اقلام بدهکار و بستانکار تولید می‌شود.</p>
    </div>

    <div class="space-y-4">
        @foreach (var v in vouchers)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-4">
                <div class="flex justify-between items-start border-b pb-3">
                    <div>
                        <span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-bold">سند شماره @v.Id</span>
                        <h3 class="text-lg font-bold text-gray-800 mt-2">@v.Title</h3>
                        <p class="text-xs text-gray-500 mt-0.5">تاریخ: @v.DateJ — مرجع: @v.RefType (شماره @v.RefId)</p>
                    </div>
                    <div class="text-left text-xs text-gray-400 font-mono">
                        @v.Descr
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-xs text-gray-600 border-b">
                                <th class="p-3">کد حساب</th>
                                <th class="p-3">نام حساب</th>
                                <th class="p-3">بدهکار (تومان)</th>
                                <th class="p-3">بستانکار (تومان)</th>
                                <th class="p-3">شرح ردیف</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y text-xs text-gray-700">
                            @foreach (var row in v.Rows)
                            {
                                <tr>
                                    <td class="p-3 font-mono font-bold text-amber-600">@row.AccountCode</td>
                                    <td class="p-3 font-semibold">@row.AccountName</td>
                                    <td class="p-3 text-blue-600 font-bold">@(row.Debit > 0 ? row.Debit.ToString("N0") : "—")</td>
                                    <td class="p-3 text-purple-600 font-bold">@(row.Credit > 0 ? row.Credit.ToString("N0") : "—")</td>
                                    <td class="p-3 text-gray-500">@row.Descr</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (!vouchers.Any())
        {
            <div class="bg-white rounded-xl p-8 text-center text-gray-500 shadow-sm border">
                هنوز سند حسابداری اتوماتیکی صادر نشده است.
            </div>
        }
    </div>
</div>

@code {
    private List<AccountingVoucher> vouchers = new();

    protected override void OnInitialized()
    {
        vouchers = Db.AccountingVouchers.Include(v => v.Rows).OrderByDescending(v => v.Id).ToList();
    }
}
