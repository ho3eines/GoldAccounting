@page "/checks"
@inject AppDbContext Db
@inject TalayarService Svc

<PageTitle>مدیریت چک‌ها و اسناد بانکی</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">💳 مدیریت چک‌ها و اوراق بهادار</h2>
            <p class="text-sm text-gray-500 mt-1">چک‌های دریافتی و پرداختی — پاس‌شده با انتقال خودکار به بانک و برگشت با سند معکوس.</p>
        </div>
        <a href="/docs/new?type=check_recv" class="bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-xl font-bold shadow transition">＋ ثبت چک (از سند)</a>
    </div>

    @if (msg.Length > 0)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 p-3 rounded-xl text-sm font-semibold">@msg</div>
    }

    <!-- فیلتر وضعیت -->
    <div class="flex gap-1 bg-gray-100 rounded-xl p-1 w-fit">
        @for (int i = 0; i < 4; i++)
        {
            var idx = i;
            <button @onclick="() => filter = idx" class="px-4 py-2 rounded-lg text-xs font-bold transition @(filter == idx ? "bg-white shadow text-amber-700" : "text-gray-500")">@(idx == 0 ? "همه" : idx == 1 ? "باز" : idx == 2 ? "پاس‌شده" : "برگشتی")</button>
        }
    </div>

    <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[800px]">
                <thead>
                    <tr class="bg-gray-50 border-b text-gray-600 text-xs md:text-sm">
                        <th class="p-4">شماره چک</th>
                        <th class="p-4">نوع</th>
                        <th class="p-4">صاحب / طرف حساب</th>
                        <th class="p-4">مبلغ (تومان)</th>
                        <th class="p-4">سررسید</th>
                        <th class="p-4">وضعیت</th>
                        <th class="p-4">عملیات</th>
                    </tr>
                </thead>
                <tbody class="divide-y text-sm text-gray-700">
                    @foreach (var chk in checks)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="p-4 font-mono font-bold text-amber-600">@Talayar.Dig(chk.No)</td>
                            <td class="p-4">
                                <span class="bg-blue-50 text-blue-700 text-xs px-2.5 py-1 rounded">@(chk.Kind == "receive" ? "دریافتی" : "پرداختی")</span>
                            </td>
                            <td class="p-4 font-semibold">@chk.Cname</td>
                            <td class="p-4 font-bold text-gray-900">@Talayar.Money(chk.Amount)</td>
                            <td class="p-4">@Talayar.Dig(chk.DueJ)</td>
                            <td class="p-4">
                                <span class="text-xs px-2.5 py-1 rounded font-bold @(chk.Status == "pass" ? "bg-green-100 text-green-700" : chk.Status == "ret" ? "bg-red-100 text-red-700" : chk.Status == "void" ? "bg-gray-100 text-gray-500" : "bg-purple-50 text-purple-700")">@TalayarService.CheckStatusName(chk.Status)</span>
                            </td>
                            <td class="p-4">
                                @if (chk.Status == "open")
                                {
                                    <div class="flex gap-2">
                                        <button @onclick="() => PassCheck(chk.Id)" class="bg-green-50 hover:bg-green-100 text-green-700 px-3 py-1.5 rounded-xl font-bold text-xs">پاس شد ✓</button>
                                        <button @onclick="() => ReturnCheck(chk.Id)" class="bg-amber-50 hover:bg-amber-100 text-amber-700 px-3 py-1.5 rounded-xl font-bold text-xs">برگشت ↩</button>
                                        <button @onclick="() => VoidCheck(chk.Id)" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-xl font-bold text-xs">ابطال</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">@chk.Descr</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!checks.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-gray-500">چکی ثبت نشده — از «ثبت سند» گروه «چک» استفاده کنید.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<CheckTransaction> checks = new();
    private int filter;
    private string msg = "";

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        var q = Db.CheckTransactions.AsQueryable();
        if (filter == 1) q = q.Where(c => c.Status == "open");
        if (filter == 2) q = q.Where(c => c.Status == "pass");
        if (filter == 3) q = q.Where(c => c.Status == "ret");
        checks = q.OrderBy(c => c.DueJ).ThenByDescending(c => c.Id).Take(300).ToList();
    }

    private void PassCheck(int id)
    {
        Svc.SetCheckStatus(id, "pass");
        msg = "پاس شدن چک ثبت شد ✓";
        Load();
    }

    private void ReturnCheck(int id)
    {
        Svc.SetCheckStatus(id, "ret");
        msg = "برگشت چک ثبت شد ✓";
        Load();
    }

    private void VoidCheck(int id)
    {
        Svc.SetCheckStatus(id, "void");
        msg = "چک باطل شد ✓";
        Load();
    }
}
