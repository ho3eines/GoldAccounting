@page "/"
@inject AppDbContext Db

<PageTitle>داشبورد مدیریت طلایار</PageTitle>

<div class="space-y-6">
    <div class="bg-gradient-to-r from-amber-600 to-amber-700 text-white p-6 rounded-2xl shadow-lg">
        <h2 class="text-2xl font-bold">خوش آمدید؛ سیستم مدیریت جامع طلا و حسابداری ابری</h2>
        <p class="text-amber-100 mt-2 text-sm">برنامه اندروید شما به صورت آفلاین کار می‌کند و با وارد کردن آدرس سرور در تنظیمات، تمامی فاکتورها و تراکنش‌ها را با کد رهگیری یکتا (جهت جلوگیری از تکرار) با این سرور همگام‌سازی می‌کند.</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">کل فاکتورها / فروش</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-1">@invoiceCount</h3>
            </div>
            <div class="bg-amber-50 p-3 rounded-full text-amber-600 text-xl">🧾</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">مشتریان ثبت‌شده</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-1">@customerCount</h3>
            </div>
            <div class="bg-blue-50 p-3 rounded-full text-blue-600 text-xl">👥</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">اسناد حسابداری (اتوماتیک)</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-1">@voucherCount</h3>
            </div>
            <div class="bg-green-50 p-3 rounded-full text-green-600 text-xl">📑</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">همگام‌سازی‌های موفق اندروید</p>
                <h3 class="text-2xl font-bold text-gray-800 mt-1">@syncCount</h3>
            </div>
            <div class="bg-purple-50 p-3 rounded-full text-purple-600 text-xl">🔄</div>
        </div>
    </div>

    <!-- Quick API Info Box -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 space-y-4">
        <h3 class="text-lg font-bold text-gray-800">🔗 اطلاعات اتصال API برای برنامه اندروید</h3>
        <p class="text-sm text-gray-600">برای اتصال برنامه اندروید به این سرور ابری، آدرس زیر را در بخش <strong>تنظیمات > آدرس سرور همگام‌سازی</strong> در اپلیکیشن اندروید وارد کنید:</p>
        <div class="bg-gray-100 p-3 rounded-lg font-mono text-sm text-amber-700 select-all">
            @serverApiUrl/api/sync/push
        </div>
        <p class="text-xs text-gray-500">نکته: هر تراکنش دارای یک کد یکتا (TransferCode) است که از ارسال تکراری داده‌های آفلاین جلوگیری می‌کند.</p>
    </div>
</div>

@code {
    private int invoiceCount;
    private int customerCount;
    private int voucherCount;
    private int syncCount;
    private string serverApiUrl = "http://localhost:5000";

    protected override void OnInitialized()
    {
        invoiceCount = Db.Invoices.Count();
        customerCount = Db.Customers.Count();
        voucherCount = Db.AccountingVouchers.Count();
        syncCount = Db.SyncLogs.Count();
    }
}
