@page "/"
@inject AppDbContext Db
@inject TalayarService Svc

<PageTitle>داشبورد مدیریت حرفه‌ای طلایار</PageTitle>

<div class="space-y-6">
    <!-- Top Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-amber-900 to-amber-700 text-white p-6 md:p-8 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center">
        <div class="space-y-2">
            <span class="bg-amber-500 text-slate-900 text-xs px-3 py-1 rounded-full font-bold">نسخه حرفه‌ای ابری + موبایل</span>
            <h2 class="text-2xl md:text-3xl font-bold">داشبورد مدیریت یکپارچه طلا، حسابداری و فروش</h2>
            <p class="text-amber-100 text-sm max-w-2xl">تمامی اطلاعات دستگاه‌های اندروید به‌صورت کاملاً امن با سرور همگام‌سازی شده‌اند و برنامه وب کاملاً ریسپانسیو آماده مدیریت و چاپ اسناد است.</p>
        </div>
        <div class="mt-4 md:mt-0 bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 text-center min-w-[220px]">
            <p class="text-xs text-amber-200">نرخ امروز طلا (گرم ۱۸ عیار)</p>
            <p class="text-2xl font-bold text-amber-400 mt-1">@(rate > 0 ? Talayar.Money(rate) + " تومان" : "ثبت نشده")</p>
            <p class="text-xs text-amber-200 mt-1">@Talayar.Jal.LongToday()</p>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">تراز صندوق</p>
            <h3 class="text-lg md:text-2xl font-bold @(cashBal >= 0 ? "text-gray-800" : "text-red-600") mt-1">@Talayar.Money(cashBal)</h3>
            <p class="text-[10px] text-gray-400">تومان</p>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">طلای آب‌شده (۱۸ معادل)</p>
            <h3 class="text-lg md:text-2xl font-bold text-gray-800 mt-1">@Talayar.Mw(gold.eq)</h3>
            <p class="text-[10px] text-gray-400">گرم</p>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">فروش امروز</p>
            <h3 class="text-lg md:text-2xl font-bold text-amber-700 mt-1">@Talayar.Money(today[1])</h3>
            <p class="text-[10px] text-gray-400">@Talayar.Dig(today[0]) فاکتور</p>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">طلب از مشتریان (نقدی)</p>
            <h3 class="text-lg md:text-2xl font-bold @(debts.cash > 0 ? "text-amber-700" : "text-gray-800") mt-1">@Talayar.Money(debts.cash)</h3>
            <p class="text-[10px] text-gray-400">@(debts.gold != 0 ? "طلایی: " + Talayar.Mw(debts.gold) + " گرم" : "تومان")</p>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">کل فاکتورها</p>
            <h3 class="text-xl md:text-2xl font-bold text-gray-800 mt-1">@Talayar.Dig(invoiceCount)</h3>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">مشتریان ثبت‌شده</p>
            <h3 class="text-xl md:text-2xl font-bold text-gray-800 mt-1">@Talayar.Dig(customerCount)</h3>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">اسناد حسابداری اتوماتیک</p>
            <h3 class="text-xl md:text-2xl font-bold text-gray-800 mt-1">@Talayar.Dig(voucherCount)</h3>
        </div>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
            <p class="text-xs md:text-sm text-gray-500 font-medium">همگام‌سازی‌های موفق</p>
            <h3 class="text-xl md:text-2xl font-bold text-gray-800 mt-1">@Talayar.Dig(syncCount)</h3>
        </div>
    </div>

    <!-- دسترسی سریع -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        <a href="docs/new" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">📜</p><p class="text-xs font-bold text-gray-700 mt-1">ثبت سند جدید</p>
        </a>
        <a href="invoices/new" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🧾</p><p class="text-xs font-bold text-gray-700 mt-1">فاکتور فروش جدید</p>
        </a>
        <a href="buy" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🛍️</p><p class="text-xs font-bold text-gray-700 mt-1">خرید طلای کارکرده</p>
        </a>
        <a href="rates" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🪙</p><p class="text-xs font-bold text-gray-700 mt-1">نرخ روز طلا</p>
        </a>
        <a href="prices" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🌐</p><p class="text-xs font-bold text-gray-700 mt-1">قیمت‌های بازار</p>
        </a>
        <a href="customers" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">👥</p><p class="text-xs font-bold text-gray-700 mt-1">حساب‌ها / مشتریان</p>
        </a>
        <a href="items" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">📦</p><p class="text-xs font-bold text-gray-700 mt-1">اجناس و انبار</p>
        </a>
        <a href="cash" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">💰</p><p class="text-xs font-bold text-gray-700 mt-1">صندوق</p>
        </a>
        <a href="gold" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">⚖️</p><p class="text-xs font-bold text-gray-700 mt-1">طلا و آب‌شده</p>
        </a>
        <a href="banks" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🏦</p><p class="text-xs font-bold text-gray-700 mt-1">بانک‌ها</p>
        </a>
        <a href="etikets" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🏷</p><p class="text-xs font-bold text-gray-700 mt-1">اتیکت‌ها</p>
        </a>
        <a href="assets" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">📊</p><p class="text-xs font-bold text-gray-700 mt-1">دارایی‌ها و تراز</p>
        </a>
        <a href="reports" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">📈</p><p class="text-xs font-bold text-gray-700 mt-1">گزارش‌ها</p>
        </a>
        <a href="docs" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🗂</p><p class="text-xs font-bold text-gray-700 mt-1">دفتر اسناد</p>
        </a>
        <a href="defs" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">🗄</p><p class="text-xs font-bold text-gray-700 mt-1">کدینگ‌ها</p>
        </a>
        <a href="settings" class="p-4 bg-white hover:bg-amber-50 rounded-2xl shadow-sm border text-center transition">
            <p class="text-2xl">⚙️</p><p class="text-xs font-bold text-gray-700 mt-1">تنظیمات و بکاپ</p>
        </a>
    </div>

    <!-- Quick API & Android Sync Settings Box -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
            <h3 class="text-lg font-bold text-gray-800 flex items-center">
                <span class="ml-2">🔗</span> اتصال برنامه اندروید به سرور
            </h3>
            <p class="text-xs md:text-sm text-gray-600">برای همگام‌سازی دوطرفه اطلاعات اندروید و سرور، آدرس زیر را در برنامه اندروید (تنظیمات > همگام‌سازی ابری) وارد کنید:</p>
            <div class="bg-gray-50 p-3 rounded-xl font-mono text-xs md:text-sm text-amber-700 border select-all">
                @serverApiUrl/api/sync/push
            </div>
            <p class="text-xs text-gray-500">تمامی داده‌ها (فاکتورها، چک‌ها، صندوق، مشتریان) با کد رهگیری یکتا (Idempotent) کاملاً باهم ساین و هماهنگ می‌شوند.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
            <h3 class="text-lg font-bold text-gray-800 flex items-center">
                <span class="ml-2">⚡</span> دسترسی سریع به ماژول‌ها
            </h3>
            <div class="grid grid-cols-2 gap-3">
                <a href="invoices" class="p-3 bg-amber-50 hover:bg-amber-100 rounded-xl text-amber-800 font-bold text-sm text-center transition">🧾 فاکتورها و فروش</a>
                <a href="accounting" class="p-3 bg-green-50 hover:bg-green-100 rounded-xl text-green-800 font-bold text-sm text-center transition">📑 اسناد حسابداری</a>
                <a href="checks" class="p-3 bg-blue-50 hover:bg-blue-100 rounded-xl text-blue-800 font-bold text-sm text-center transition">💳 مدیریت چک‌ها</a>
                <a href="onlineshop" class="p-3 bg-purple-50 hover:bg-purple-100 rounded-xl text-purple-800 font-bold text-sm text-center transition">🛒 فروشگاه آنلاین</a>
            </div>
        </div>
    </div>
</div>

@code {
    private int invoiceCount;
    private int customerCount;
    private int voucherCount;
    private int syncCount;
    private long rate, cashBal;
    private (long raw, long eq) gold;
    private (long cash, long gold) debts;
    private long[] today = new long[6];
    private string serverApiUrl = "http://localhost:5000";

    protected override void OnInitialized()
    {
        invoiceCount = Db.Invoices.Count();
        customerCount = Db.Customers.Count();
        voucherCount = Db.AccountingVouchers.Count();
        syncCount = Db.SyncLogs.Count();
        rate = Svc.CurrentRate();
        cashBal = Svc.CashBalance();
        gold = Svc.GoldBalance();
        debts = Svc.CustomerDebts();
        today = Svc.SalesStats(Talayar.Jal.Today());
    }
}
