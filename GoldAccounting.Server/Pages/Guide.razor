@page "/guide"
@inject AppDbContext Db
@inject TalayarService Svc

<PageTitle>راهنمای استفاده از طلایار</PageTitle>

<div class="space-y-6">
    <!-- سربرگ راهنما -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-amber-950 to-amber-800 text-white p-6 md:p-10 shadow-xl">
        <div class="absolute -left-16 -top-16 w-56 h-56 bg-amber-400/10 rounded-full blur-3xl"></div>
        <div class="relative max-w-3xl space-y-4">
            <span class="inline-flex items-center gap-1.5 bg-amber-500 text-slate-900 text-xs px-3 py-1.5 rounded-full font-black shadow">📖 آموزش کامل و ساده</span>
            <h1 class="text-3xl md:text-4xl font-black leading-tight">راهنمای استفاده از طلایار</h1>
            <p class="text-amber-100/85 text-sm md:text-base leading-relaxed">
                این راهنما مخصوص کسانی نوشته شده که <b class="text-amber-300">اولین بار</b> با سیستم حسابداری طلافروشی کار می‌کنند.
                همهٔ اصطلاحات به زبان ساده توضیح داده شده و برای هر بخش، قدم‌به‌قدم گفته‌ایم چه کار کنید.
            </p>
            <div class="flex flex-wrap gap-2 pt-1">
                <a href="#start" class="bg-white/10 hover:bg-white/20 border border-white/15 rounded-xl px-4 py-2 text-xs font-bold transition">🚀 شروع سریع</a>
                <a href="#glossary" class="bg-white/10 hover:bg-white/20 border border-white/15 rounded-xl px-4 py-2 text-xs font-bold transition">📚 واژه‌نامه (اصطلاحات)</a>
                <a href="#help-contact" class="bg-white/10 hover:bg-white/20 border border-white/15 rounded-xl px-4 py-2 text-xs font-bold transition">🆘 سؤال دارید؟</a>
            </div>
        </div>
    </div>

    <!-- جستجو -->
    <div class="card-lux p-4 sticky top-16 z-20">
        <div class="flex gap-2">
            <span class="text-xl">🔍</span>
            <input @bind="q" @bind:event="oninput" placeholder="جستجو در راهنما… مثلاً: فاکتور، عیار، پیامک، اتیکت" class="flex-1 border rounded-xl p-3 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none" />
        </div>
    </div>

    <!-- فهرست موضوعات (موبایل: انتخابگر) -->
    <div class="md:hidden card-lux p-3">
        <select @onchange="OnSelectJump" class="w-full border rounded-xl p-3 text-sm">
            <option value="">— رفتن به بخش —</option>
            @foreach (var s in visibleSections)
            {
                <option value="@s.Id">@s.Icon @s.Title</option>
            }
        </select>
    </div>

    <div class="flex gap-6 items-start">
        <!-- سایدبار فهرست (دسکتاپ) -->
        <aside class="hidden md:block w-64 shrink-0 sticky top-36 max-h-[70vh] overflow-y-auto">
            <div class="card-lux p-3 space-y-0.5">
                <p class="px-3 pt-1 pb-2 text-[10px] font-black text-gray-400">فهرست راهنما</p>
                @foreach (var s in visibleSections)
                {
                    <a href="#@s.Id" class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-amber-50 text-gray-600 hover:text-amber-800 text-xs font-bold transition">
                        <span>@s.Icon</span> @s.Title
                    </a>
                }
            </div>
        </aside>

        <!-- محتوا -->
        <div class="flex-1 min-w-0 space-y-6">
            @if (!visibleSections.Any())
            {
                <div class="card-lux p-12 text-center">
                    <p class="text-4xl mb-3">🤔</p>
                    <p class="text-gray-500 font-bold">موردی با این عبارت پیدا نشد.</p>
                    <p class="text-xs text-gray-400 mt-1">عبارت دیگری امتحان کنید یا از فهرست کامل استفاده کنید.</p>
                </div>
            }

            @foreach (var s in visibleSections)
            {
                <section id="@s.Id" class="card-lux p-6 md:p-7 scroll-mt-36">
                    <div class="flex items-center gap-3 border-b border-amber-100 pb-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 text-slate-900 flex items-center justify-center text-2xl shadow-lg shadow-amber-500/20">@s.Icon</div>
                        <div>
                            <h2 class="text-lg md:text-xl font-black text-gray-800">@s.Title</h2>
                            @if (s.Alias.Length > 0)
                            {
                                <p class="text-[11px] text-gray-400">نام‌های دیگر: @s.Alias</p>
                            }
                        </div>
                    </div>

                    @if (s.What.Length > 0)
                    {
                        <div class="mt-4 bg-sky-50/70 border border-sky-100 rounded-2xl p-4">
                            <p class="text-[11px] font-black text-sky-700 mb-1">💡 این بخش چیست؟</p>
                            <p class="text-sm text-gray-700 leading-relaxed">@s.What</p>
                        </div>
                    }

                    @if (s.Terms.Any())
                    {
                        <div class="mt-4">
                            <p class="text-[11px] font-black text-gray-500 mb-2">📚 اصطلاحات این بخش</p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                @foreach (var t in s.Terms)
                                {
                                    <div class="bg-gray-50 rounded-xl px-3 py-2.5 text-xs">
                                        <b class="text-amber-700">@t.Name:</b>
                                        <span class="text-gray-600"> @t.Mean</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (s.Steps.Any())
                    {
                        <div class="mt-4">
                            <p class="text-[11px] font-black text-gray-500 mb-2">🪜 نحوهٔ استفاده (قدم به قدم)</p>
                            <ol class="space-y-2">
                                @for (int i = 0; i < s.Steps.Count; i++)
                                {
                                    <li class="flex gap-3 text-sm text-gray-700 leading-relaxed">
                                        <span class="shrink-0 w-6 h-6 rounded-full bg-amber-600 text-white text-[11px] font-black flex items-center justify-center mt-0.5">@Talayar.Dig(i + 1)</span>
                                        <span>@s.Steps[i]</span>
                                    </li>
                                }
                            </ol>
                        </div>
                    }

                    @if (s.Tips.Any())
                    {
                        <div class="mt-4 space-y-2">
                            @foreach (var tip in s.Tips)
                            {
                                <div class="bg-amber-50/80 border border-amber-100 rounded-xl px-4 py-3 text-xs text-amber-900 leading-relaxed">⭐ <b>نکته:</b> @tip</div>
                            }
                        </div>
                    }
                </section>
            }

            <!-- تماس -->
            <section id="help-contact" class="card-lux p-6 text-center scroll-mt-36">
                <p class="text-3xl mb-2">🆘</p>
                <h3 class="font-black text-gray-800 text-lg">هنوز سؤال دارید؟</h3>
                <p class="text-sm text-gray-500 mt-1">با پشتیبانی تماس بگیرید یا از منوی همبرگری بخش‌های مختلف را امتحان کنید — نگران خراب‌شدن چیزی نباشید، همهٔ عملیات قابل برگشت یا اصلاح است.</p>
                <div class="mt-3 flex justify-center gap-2">
                    <a href="tel:02188880000" class="btn-gold text-xs">📞 تماس با پشتیبانی</a>
                    <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2.5 rounded-xl font-bold text-xs">🏠 بازگشت به داشبورد</a>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    record Term(string Name, string Mean);
    record GuideSection(string Id, string Icon, string Title, string Alias, string What, List<Term> Terms, List<string> Steps, List<string> Tips);

    private string q = "";
    private List<GuideSection> allSections = new();
    private List<GuideSection> visibleSections => string.IsNullOrWhiteSpace(q)
        ? allSections
        : allSections.Where(s =>
            s.Title.Contains(q) ||
            s.Alias.Contains(q) ||
            s.What.Contains(q) ||
            s.Terms.Any(t => t.Name.Contains(q) || t.Mean.Contains(q)) ||
            s.Steps.Any(st => st.Contains(q))).ToList();

    protected override void OnInitialized()
    {
        BuildSections();
    }

    private void OnSelectJump(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id))
        {
            // اسکرول به بخش (JS ساده)
        }
    }

