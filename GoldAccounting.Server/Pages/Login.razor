@page "/login"
@layout GoldAccounting.Server.Shared.LoginLayout
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject EventService Events

<PageTitle>ورود به سامانه طلایار</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-amber-950 to-slate-900 p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md p-8 space-y-6 border border-amber-500/20">
        <div class="text-center space-y-2">
            <div class="inline-flex bg-amber-100 text-amber-700 p-3 rounded-2xl text-2xl mb-2">🪙</div>
            <h1 class="text-2xl font-bold text-gray-900">سامانه مدیریت طلایار</h1>
            <p class="text-xs text-gray-500">لطفاً برای ورود به پنل مدیریت و همگام‌سازی وارد شوید</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-xl text-xs font-semibold text-center">
                @errorMessage
            </div>
        }

        <div class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">نام کاربری</label>
                <input @value="username" placeholder="admin" class="w-full border rounded-xl p-3 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">رمز عبور</label>
                <input type="password" @value="password" placeholder="••••••••" class="w-full border rounded-xl p-3 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none" />
            </div>

            <button @onclick="HandleLogin" class="w-full bg-amber-600 hover:bg-amber-700 text-white py-3.5 rounded-xl font-bold shadow-lg shadow-amber-600/20 transition">
                ورود به حساب کاربری
            </button>
        </div>

        <div class="text-center text-xs text-gray-400 pt-4 border-t">
            نام کاربری پیش‌فرض: <strong class="text-gray-600">admin</strong> | رمز عبور: <strong class="text-gray-600">admin123</strong>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private void HandleLogin()
    {
        var user = Db.UserAccounts.FirstOrDefault(u => u.Username == username && u.Password == password);
        if (user != null)
        {
            Events.LogLogin(user.Username, true, "web");
            Navigation.NavigateTo("/");
        }
        else
        {
            Events.LogLogin(username, false, "web");
            errorMessage = "نام کاربری یا رمز عبور اشتباه است.";
        }
    }
}
